# ============================================================
# SoberClaw AI 提供商配置
# 以下四选一填写，优先级：Claude > 豆包 > 通义千问 > OpenAI
# ============================================================

# ── 方案一：Claude (Anthropic) ─────────────────────────────
# 获取地址: https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxx

# ── 方案二：豆包 (火山引擎) ────────────────────────────────
# 1. 登录 https://console.volcengine.com/ark
# 2. 创建"推理接入点"，复制"接入点ID"（格式 ep-20240xxx）
# 3. 在 API Key 管理页创建 Key
# DOUBAO_API_KEY=xxxxxxxx
# DOUBAO_MODEL=ep-20240xxx

# ── 方案三：通义千问 (阿里云百炼) ──────────────────────────
# 获取地址: https://bailian.console.aliyun.com/
# DASHSCOPE_API_KEY=sk-xxxxxxxx
# DASHSCOPE_MODEL=qwen-plus   # 可选: qwen-max / qwen-turbo

# ── 方案四：OpenAI 或兼容接口 ─────────────────────────────
# DeepSeek: OPENAI_BASE_URL=https://api.deepseek.com  OPENAI_MODEL=deepseek-chat
# Kimi:     OPENAI_BASE_URL=https://api.moonshot.cn/v1  OPENAI_MODEL=moonshot-v1-8k
# OPENAI_API_KEY=sk-xxxxxxxx
# OPENAI_BASE_URL=
# OPENAI_MODEL=gpt-4o-mini

# ── 前端配置 ───────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
